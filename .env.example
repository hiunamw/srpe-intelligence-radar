# ==========================================
# SRPE ETL Pipeline - Environment Variables
# ==========================================
# ⚠️ 警告: 絕對不要將真實的 .env 檔案上傳到 GitHub！
# 使用說明: 請將此檔案複製並重新命名為 .env，然後填入您的真實測試憑證。

# 1. 雲端資料庫設定 (Cloud SQL / PostgreSQL)
# 格式: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://demo_user:demo_password@localhost:5432/srpe_db

# 2. Discord 情報推送設定 (Webhook)
# 請填入從 Discord 頻道設定中獲取的 Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
